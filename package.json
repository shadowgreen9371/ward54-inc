{
  "name": "ward54-inc",
  "private": true,
  "version": "2.0.0",
  "description": "Ward 54 INC — Voter Directory + Admin CMS (Next.js monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:public": "pnpm --filter @ward54/public dev",
    "dev:admin": "pnpm --filter @ward54/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "extract:voters": "node scripts/extract-voters.mjs"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
