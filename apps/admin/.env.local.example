# Copy to apps/admin/.env.local — admin needs anon + service-role.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — bypasses RLS. NEVER expose to the browser, never commit.
# Only used by trusted server-side admin code.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin site URL.
NEXT_PUBLIC_SITE_URL=https://admin.ward54.in
